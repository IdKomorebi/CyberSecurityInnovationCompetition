{
  "duration": 313.71958333333333,
  "post_speed": 1.12,
  "model": "qwen-audio-3.1-tts-flash",
  "voice": "longanlingxin_v3.1",
  "items": [
    {
      "id": 1,
      "section": "01 问题：字段之间的关联",
      "text": "数据分级一般是逐个字段来定的：看这个字段本身泄露后影响多大，定一个级别。",
      "source_duration": 7.054541666666666,
      "start": 0.8,
      "end": 7.097375,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 2,
      "section": "01 问题：字段之间的关联",
      "text": "但字段之间有关联。接收方把几个低级别字段放在一起，训练一个预测模型，就可能推出不该拿到的数据。",
      "source_duration": 9.090916666666667,
      "start": 7.297375,
      "end": 15.421917,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 3,
      "section": "01 问题：字段之间的关联",
      "text": "这里用训练好的神经网络推断模型的准确率来衡量推断能力，并设定 0.7 为阈值。",
      "source_duration": 6.909083333333333,
      "start": 15.621917,
      "end": 21.754875,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 4,
      "section": "01 问题：字段之间的关联",
      "text": "以澳大利亚电力市场为例，可用发电容量、风电预测、光伏预测都是公开数据，单独用来推燃气机组的出力，准确率只有 0.05、0.18 和 0.19。",
      "source_duration": 14.472708333333333,
      "start": 21.954875,
      "end": 34.857458,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 5,
      "section": "01 问题：字段之间的关联",
      "text": "任意两项组合也都不到 0.52，三项放在一起却达到 0.81，越过了阈值。",
      "source_duration": 7.054541666666666,
      "start": 35.057458,
      "end": 41.343208,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 6,
      "section": "01 问题：字段之间的关联",
      "text": "所以分级还要考虑字段之间的协同：一个字段能带来多大推断能力，哪些字段一起开放会产生风险。",
      "source_duration": 9.309083333333334,
      "start": 41.543208,
      "end": 49.870417,
      "gap_after": 0.65,
      "caption_parts": 2
    },
    {
      "id": 7,
      "section": "02 新建任务",
      "text": "使用时只需上传一张数据表。",
      "source_duration": 3.127291666666667,
      "start": 50.520417,
      "end": 53.30525,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 8,
      "section": "02 新建任务",
      "text": "大模型起草字段目录，需要保护哪些数据由我们确认，之后后台自动完成全部步骤。",
      "source_duration": 7.054541666666666,
      "start": 53.50525,
      "end": 59.811375,
      "gap_after": 0.65,
      "caption_parts": 1
    },
    {
      "id": 9,
      "section": "03 字段本身：一次定级与单独推断",
      "text": "第一步是一次定级，依据国家标准 GB/T 43697。",
      "source_duration": 6.836375,
      "start": 60.461375,
      "end": 66.551917,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 10,
      "section": "03 字段本身：一次定级与单独推断",
      "text": "大模型只判断字段泄露后影响谁、影响多大，级别由国标的判定表查出，结果可以人工或另一个大模型复核。",
      "source_duration": 9.163625,
      "start": 66.751917,
      "end": 74.916292,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 11,
      "section": "03 字段本身：一次定级与单独推断",
      "text": "这份数据里，30 个公开字段都是 1 级，3 台机组的出力是 2 级，社会公众无权获取。",
      "source_duration": 7.636375,
      "start": 75.116292,
      "end": 81.919125,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 12,
      "section": "03 字段本身：一次定级与单独推断",
      "text": "单独推断时，最高的南澳出清价也只有 0.58，没有一个字段单独越线。",
      "source_duration": 6.4,
      "start": 82.119125,
      "end": 87.836125,
      "gap_after": 0.65,
      "caption_parts": 1
    },
    {
      "id": 13,
      "section": "04 聚合推断风险之一：字段推断风险 M",
      "text": "刚才的单独推断，是看只拿到这一个字段，能推出多少。",
      "source_duration": 4.727291666666667,
      "start": 88.486125,
      "end": 92.715708,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 14,
      "section": "04 聚合推断风险之一：字段推断风险 M",
      "text": "字段推断风险 M 则进一步考虑：攻击者已经掌握一些背景，再拿到这个字段，推断能力最多能增加多少。",
      "source_duration": 9.890916666666667,
      "start": 92.915708,
      "end": 101.728,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 15,
      "section": "04 聚合推断风险之一：字段推断风险 M",
      "text": "我们不知道对方具体掌握了什么，就在至多 K 个背景字段的范围内，寻找让这个字段发挥最大作用的背景。",
      "source_duration": 9.090916666666667,
      "start": 101.928,
      "end": 110.027333,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 16,
      "section": "04 聚合推断风险之一：字段推断风险 M",
      "text": "比如，只有可用容量和光伏预测时，准确率是 0.22；再加上风电预测，就提高到 0.81。",
      "source_duration": 8.363625,
      "start": 110.227333,
      "end": 117.701375,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 17,
      "section": "04 聚合推断风险之一：字段推断风险 M",
      "text": "风电预测带来的增量是 0.59，也就是它的 M，明显高于单独推断时的 0.18。",
      "source_duration": 6.618166666666666,
      "start": 117.901375,
      "end": 123.823,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 18,
      "section": "04 聚合推断风险之一：字段推断风险 M",
      "text": "没有背景也包含在比较范围里，所以 M 不会低于单独推断能力。",
      "source_duration": 6.254541666666666,
      "start": 124.023,
      "end": 129.584917,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 19,
      "section": "04 聚合推断风险之一：字段推断风险 M",
      "text": "这样就能从攻击者的视角，在设定的背景范围内，更客观地衡量一个字段与其他字段协同后，究竟能提供多少推断能力。",
      "source_duration": 10.836375,
      "start": 129.784917,
      "end": 139.430542,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 20,
      "section": "04 聚合推断风险之一：字段推断风险 M",
      "text": "K 由系统根据数据自动选定，这份数据取 3；切换 K，可以查看不同背景范围下的结果和推断曲线。",
      "source_duration": 9.963625,
      "start": 139.630542,
      "end": 148.507875,
      "gap_after": 0.65,
      "caption_parts": 2
    },
    {
      "id": 21,
      "section": "05 聚合推断风险之二：越线组合",
      "text": "M 为字段本身提供了考虑协同后的风险依据，但定级还要看实际的共享情况：接收方能拿到哪些字段，哪些组合已经足以推出保护对象。",
      "source_duration": 12.509083333333333,
      "start": 149.157875,
      "end": 160.319,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 22,
      "section": "05 聚合推断风险之二：越线组合",
      "text": "越线组合页展示的就是这些具体风险。燃气机组已有 13 个重训确认的最小越线组合，风电预测出现在每一个里面。",
      "source_duration": 10.545458333333332,
      "start": 160.519,
      "end": 169.921833,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 23,
      "section": "05 聚合推断风险之二：越线组合",
      "text": "以右边这组为例，三个字段凑齐就越线，少任何一个都不过线；只要不再同时向该接收方开放，这个组合就被拆开。",
      "source_duration": 9.309083333333334,
      "start": 170.121833,
      "end": 178.426208,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 24,
      "section": "05 聚合推断风险之二：越线组合",
      "text": "规模更大的组合，由估计器当场打分，再挑出可能越线的重新训练确认。",
      "source_duration": 6.4,
      "start": 178.626208,
      "end": 184.357125,
      "gap_after": 0.65,
      "caption_parts": 1
    },
    {
      "id": 25,
      "section": "06 二次定级",
      "text": "二次定级，就是把字段的 M、实际越线组合和数据的使用需求统一起来，确定整套等级方案。",
      "source_duration": 8.654541666666667,
      "start": 185.007125,
      "end": 192.720417,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 26,
      "section": "06 二次定级",
      "text": "字段的 M 达到 0.7，就直接把它定为与对应保护对象同级；其他字段，则结合组合风险和数据使用价值，通过效用函数决定是否调高。",
      "source_duration": 13.381833333333333,
      "start": 192.920417,
      "end": 204.842833,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 27,
      "section": "06 二次定级",
      "text": "效用函数综合三件事：字段风险有多大，调高等级会损失多少可用性，还有多少越线组合仍能被接收方凑齐。",
      "source_duration": 11.272708333333334,
      "start": 205.042833,
      "end": 215.105625,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 28,
      "section": "06 二次定级",
      "text": "M 越大，留在低级别的风险扣分越多；级别越高，限制数据使用的成本也越大；没有拆开的越线组合还要额外扣分。",
      "source_duration": 10.909083333333333,
      "start": 215.305625,
      "end": 225.03125,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 29,
      "section": "06 二次定级",
      "text": "因此，方案既要降低推断风险，也要尽量保留数据的共享价值，综合得分越高越好。",
      "source_duration": 8.581833333333334,
      "start": 225.23125,
      "end": 232.883333,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 30,
      "section": "06 二次定级",
      "text": "强化学习每一步采样一批完整方案，用效用函数打分，通过组内比较更新策略，逐步找到得分更高的方案，不需要预先标注好的级别。",
      "source_duration": 11.709083333333334,
      "start": 233.083333,
      "end": 243.53075,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 31,
      "section": "06 二次定级",
      "text": "在这个案例中，联合评估学到的方案与整数规划算出的最优解完全相同。",
      "source_duration": 7.127291666666666,
      "start": 243.73075,
      "end": 250.079,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 32,
      "section": "06 二次定级",
      "text": "以风电预测为例，其他字段等级不变时，留在 1 级的得分是负 30.17，调到 2 级提高到负 23.64，并拆开 6 个组合。",
      "source_duration": 10.763625,
      "start": 250.279,
      "end": 259.869292,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 33,
      "section": "06 二次定级",
      "text": "经过后续整体核对，最终调高 17 个字段，三台机组合计 14 个已重训确认的越线组合全部拆开。",
      "source_duration": 10.4,
      "start": 260.069292,
      "end": 269.367792,
      "gap_after": 0.65,
      "caption_parts": 2
    },
    {
      "id": 34,
      "section": "07 定级效果",
      "text": "效果核对会把社会公众能拿到的字段全部合起来，重新训练，并换模型复测、取较高的结果，检查更大范围的组合是否仍有风险。",
      "source_duration": 11.2,
      "start": 270.017792,
      "end": 279.986333,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 35,
      "section": "07 定级效果",
      "text": "燃煤机组从 0.82 降到 0.64，水电机组从 0.77 降到 0.41，都到了线下。",
      "source_duration": 8.8,
      "start": 280.186333,
      "end": 288.224792,
      "gap_after": 0.2,
      "caption_parts": 2
    },
    {
      "id": 36,
      "section": "07 定级效果",
      "text": "燃气机组降到 0.73，仍略高于线，因为几乎所有公开字段都带着它的信息；再收紧代价太大，系统如实列出，也可以开启严格模式。",
      "source_duration": 12.872708333333334,
      "start": 288.424792,
      "end": 299.927333,
      "gap_after": 0.65,
      "caption_parts": 2
    },
    {
      "id": 37,
      "section": "08 结尾",
      "text": "在 7 个数据集上，用于定级的越线组合由 2116 个降到 8 个。",
      "source_duration": 6.109083333333333,
      "start": 300.577333,
      "end": 306.014833,
      "gap_after": 0.2,
      "caption_parts": 1
    },
    {
      "id": 38,
      "section": "08 结尾",
      "text": "这就是面向聚合推断威胁的数据定级与共享审查系统。谢谢观看。",
      "source_duration": 6.763625,
      "start": 306.214833,
      "end": 312.269583,
      "gap_after": 0.65,
      "caption_parts": 1
    }
  ],
