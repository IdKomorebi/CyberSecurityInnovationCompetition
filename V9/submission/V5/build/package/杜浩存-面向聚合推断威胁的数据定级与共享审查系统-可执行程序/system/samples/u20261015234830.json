非法共享，不会对个人权益、组织权益等造成危害。1级数据具有公共传播属性，可对外公开发布、转发传播，但也需考虑公开的数据量及类别，避免由于类别较多或者数量过大被用于关联分析。"}, {"编号": "附录H.1 b)", "标题": "2级数据", "内容": "对个人权益、组织权益造成一般危害。2级数据通常在组织内部、关联方共享和使用，相关方授权后可向组织外部共享。"}, {"编号": "附录H.1 c)", "标题": "3级数据", "内容": "对个人权益、组织权益造成严重危害。3级数据仅可由授权的内部机构或人员访问，如果要将数据共享到外部，需要满足相关条件并获得相关方的授权。"}, {"编号": "附录H.1 d)", "标题": "4级数据", "内容": "对个人权益、组织权益造成特别严重危害，或对经济运行、社会秩序、公共利益造成一般危害。4级数据按照批准的授权列表严格管理，仅能在受控范围内经过严格审批、评估后才可共享或传播。"}, {"编号": "附录H.4", "标题": "最低参考级别", "内容": "敏感个人信息不低于4级，一般个人信息不低于2级；组织内部员工个人信息不低于2级；去标识化的个人信息不低于2级；个人标签信息不低于2级；有条件开放/共享的公共数据级别不低于2级，禁止开放/共享的公共数据不低于4级。"}, {"编号": "附录I", "标题": "衍生数据分级参考", "内容": "脱敏数据级别可比原始数据级别降低；统计数据级别可比原始数据级别降低或升高；融合数据级别要考虑数据汇聚融合结果，如果结果数据是对大量多维数据进行关联、分析或挖掘，汇聚了更大规模的原始数据或分析挖掘出更敏感、更深层的数据，级别可以升高。"}, {"编号": "附录G", "标题": "重要数据识别", "内容": "反映关键信息基础设施网络安全保护情况、可被利用实施对关键信息基础设施的网络攻击；反映重点目标、重要场所物理安全保护情况或未公开地理目标的位置；可被利用实施对关键设备、系统组件供应链的破坏；反映国家能源、关键矿产资源等战略储备和应急动员能力；直接影响电力等关键行业领域核心业务运行或重要经济领域生产的数据，宜识别为重要数据。"}], "接收方": [{"级": 1, "名称": "社会公众", "判定线": 0.7}, {"级": 2, "名称": "关联方", "判定线": 0.8}, {"级": 3, "名称": "特定授权对象", "判定线": 0.8}, {"级": 4, "名称": "内部受控范围", "判定线": 0.8}], "组合上限": 5, "已核对的组合数": 32, "字段": [{"字段": "Temperature", "中文名": "温度", "类别": "行业数据", "公开情况": "有条件开放", "说明": "办公室环境温度读数，单位摄氏度", "影响对象": "组织权益", "影响程度": "一般危害", "一次等级": 2, "初判": {"影响对象": "组织权益", "影响程度": "一般危害", "等级": 2, "理由": "办公室温度读数仅影响本组织办公环境管理，不涉及个人或公共利益，属一般数据。"}, "复核调整": false, "检索到的条文": ["6.5 表1", "附录G", "6.6 c)", "4 d)"], "复核理由": "", "复核来源": "", "最低级别": 1, "角色": "候选", "直接定级": 2, "二次等级": 3, "M": [0.509], "见证": [["湿度"]], "单独精度": [0.422], "依据": {"直接定级": false, "对应敏感数据": null, "重新成立的数量": 0, "重新成立的越线组合": [], "各级效用": [{"等级": 2, "允许": true, "效用": -6.053, "构成": {"安全收益": -3.458, "可用性成本": -2.595, "聚合推断惩罚": -0.0, "整体推断惩罚": -0.0}, "含该字段的越线组合": 0}, {"等级": 3, "允许": true, "效用": -5.897, "构成": {"安全收益": -2.653, "可用性成本": -3.244, "聚合推断惩罚": -0.0, "整体推断惩罚": -0.0}, "含该字段的越线组合": 0}]}}, {"字段": "Humidity", "中文名": "湿度", "类别": "行业数据", "公开情况": "有条件开放", "说明": "办公室环境相对湿度读数，单位百分比", "影响对象": "组织权益", "影响程度": "一般危害", "一次等级": 2