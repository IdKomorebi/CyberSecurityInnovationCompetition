{
  "duration": 296.5119583333333,
  "post_speed": 1.2044542489370378,
  "model": "qwen-audio-3.1-tts-flash",
  "voice": "longanlingxin_v3.1",
  "items": [
    {
      "id": 1,
      "section": "01 开场",
      "text": "数据分级时，我们通常逐个字段判断等级，再按等级决定谁能拿到。",
      "source_duration": 5.454541666666667,
      "start": 0.8,
      "end": 5.320333,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 2,
      "section": "01 开场",
      "text": "但接收方拿到的，是一批字段。",
      "source_duration": 2.763625,
      "start": 5.410333,
      "end": 7.71125,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 3,
      "section": "01 开场",
      "text": "这是美国 PJM 电网的公开数据，实际网损是电网企业的内部数据，社会公众无权获取。",
      "source_duration": 8.290916666666666,
      "start": 7.80125,
      "end": 14.6775,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 4,
      "section": "01 开场",
      "text": "负荷预测、节点电价、网损电价三个字段已经公开，单独推断网损都不到 0.5，两两组合也不到 0.61。",
      "source_duration": 9.454541666666668,
      "start": 14.7675,
      "end": 22.6095,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 5,
      "section": "01 开场",
      "text": "三项合起来，推断精度达到 0.736，越过了判定线。",
      "source_duration": 5.8181666666666665,
      "start": 22.6995,
      "end": 27.500208,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 6,
      "section": "01 开场",
      "text": "每个字段的等级都没有定错，组合起来却把不该公开的数据推了出来。",
      "source_duration": 4.8,
      "start": 27.590208,
      "end": 31.557625,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 7,
      "section": "01 开场",
      "text": "我们的系统，就是在定级时把这种聚合推断风险找出来，并计入等级。",
      "source_duration": 5.963625,
      "start": 31.647625,
      "end": 36.589417,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 8,
      "section": "02 新建任务：上传一张表",
      "text": "新建任务只需要上传一张表格，CSV 或 Excel 都可以。",
      "source_duration": 5.090916666666667,
      "start": 37.089417,
      "end": 41.296667,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 9,
      "section": "02 新建任务：上传一张表",
      "text": "系统先识别每一列是数值、类别还是时间。",
      "source_duration": 4.072708333333333,
      "start": 41.386667,
      "end": 44.748917,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 10,
      "section": "02 新建任务：上传一张表",
      "text": "再由大模型根据列名和示例值，起草中文名、说明和公开情况。",
      "source_duration": 5.890916666666667,
      "start": 44.838917,
      "end": 49.7035,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 11,
      "section": "02 新建任务：上传一张表",
      "text": "哪些是需要保护的数据，由我们自己确认，这里选实际网损、发电总出力等四项。",
      "source_duration": 6.690916666666666,
      "start": 49.7935,
      "end": 55.343208,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 12,
      "section": "02 新建任务：上传一张表",
      "text": "复核方式和计算设备也在这里选，没有显卡时自动用处理器。",
      "source_duration": 5.454541666666667,
      "start": 55.433208,
      "end": 59.952125,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 13,
      "section": "03 定级进度",
      "text": "确认后，后台依次完成一次定级、复核、推断验证、二次定级、整体核对与复测。",
      "source_duration": 7.272708333333333,
      "start": 60.452125,
      "end": 66.500833,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 14,
      "section": "03 定级进度",
      "text": "进度和日志实时显示，这份数据用一张显卡约 9 分钟完成。",
      "source_duration": 5.527291666666667,
      "start": 66.590833,
      "end": 71.192417,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 15,
      "section": "04 一次定级",
      "text": "第一步是一次定级，依据国家标准 GB/T 43697。",
      "source_duration": 6.836375,
      "start": 71.692417,
      "end": 77.356792,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 16,
      "section": "04 一次定级",
      "text": "大模型只判断两件事：数据泄露后影响的对象，和影响的程度。",
      "source_duration": 6.4,
      "start": 77.446792,
      "end": 82.739417,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 17,
      "section": "04 一次定级",
      "text": "等级由国标的判定表查出来，不让大模型直接给等级。",
      "source_duration": 5.309083333333334,
      "start": 82.829417,
      "end": 87.243875,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 18,
      "section": "04 一次定级",
      "text": "判断要经过复核，比如实际网损反映的是企业自身的运行经济性，复核改为组织权益，定为 2 级。",
      "source_duration": 9.381833333333333,
      "start": 87.333875,
      "end": 95.110125,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 19,
      "section": "04 一次定级",
      "text": "也可以请另一个大模型来复核，它的意见单独列出，由人工决定是否采纳。",
      "source_duration": 5.8181666666666665,
      "start": 95.200125,
      "end": 100.042792,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 20,
      "section": "05 单字段推断风险",
      "text": "第二步是推断验证。",
      "source_duration": 2.1818333333333335,
      "start": 100.542792,
      "end": 102.372542,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 21,
      "section": "05 单字段推断风险",
      "text": "系统用接收方能拿到的字段，训练模型去推断保护对象，用留出数据上的拟合优度作为推断精度。",
      "source_duration": 8.945458333333333,
      "start": 102.462542,
      "end": 109.89825,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 22,
      "section": "05 单字段推断风险",
      "text": "对实际网损，最强的单个字段是负荷预测，也只有 0.49，没有一个字段单独过线。",
      "source_duration": 6.981833333333333,
      "start": 109.98825,
      "end": 115.769583,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 23,
      "section": "06 聚合推断：从集合到字段",
      "text": "推断风险的本质，是一组字段合起来能推到多准，它定义在字段集合上。",
      "source_duration": 6.763625,
      "start": 116.269583,
      "end": 121.891958,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 24,
      "section": "06 聚合推断：从集合到字段",
      "text": "但等级要定在每个字段上，所以我们提出了字段推断敏感度 M。",
      "source_duration": 5.6727083333333335,
      "start": 121.981958,
      "end": 126.663458,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 25,
      "section": "06 聚合推断：从集合到字段",
      "text": "M 衡量的是：接收方已经掌握了几个背景字段时，再拿到这个字段，推断精度最多能提高多少。",
      "source_duration": 9.163625,
      "start": 126.753458,
      "end": 134.331875,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 26,
      "section": "06 聚合推断：从集合到字段",
      "text": "比如日前节点边际电价，单独只有 0.27；有了两个背景字段，它带来的提高达到 0.47。",
      "source_duration": 7.927291666666667,
      "start": 134.421875,
      "end": 141.017667,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 27,
      "section": "06 聚合推断：从集合到字段",
      "text": "多出来的这一部分，就是背景增益，图中的紫色斜纹，它正是聚合推断在单个字段上的体现。",
      "source_duration": 7.490916666666666,
      "start": 141.107667,
      "end": 147.322167,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 28,
      "section": "06 聚合推断：从集合到字段",
      "text": "同时，系统找出所有最小越线组合：凑齐就越线，去掉任何一个就不越线。",
      "source_duration": 6.690916666666666,
      "start": 147.412167,
      "end": 152.970292,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 29,
      "section": "06 聚合推断：从集合到字段",
      "text": "开头那三个字段，就是一个最小越线组合。",
      "source_duration": 3.0545416666666667,
      "start": 153.060292,
      "end": 155.583208,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 30,
      "section": "06 聚合推断：从集合到字段",
      "text": "我们证明了 M 和越线组合的对应关系：成员 M 都很小的组合不可能越线，能把组合推过线的字段，一定属于某个最小越线组合。",
      "source_duration": 11.054541666666667,
      "start": 155.673208,
      "end": 164.862292,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 31,
      "section": "06 聚合推断：从集合到字段",
      "text": "所以，M 从字段的角度、越线组合从集合的角度，描述的是同一种风险。",
      "source_duration": 6.545458333333333,
      "start": 164.952292,
      "end": 170.368542,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 32,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "第三步是二次定级，分三步。",
      "source_duration": 2.9818333333333333,
      "start": 170.868542,
      "end": 173.354542,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 33,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "首先，M 达到 0.7 的字段几乎相当于保护对象本身，直接定为同级。",
      "source_duration": 6.1818333333333335,
      "start": 173.444542,
      "end": 178.589292,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 34,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "两项负荷预测对发电总出力的 M 达到 0.97，直接调到 4 级，这同时拆开了实际网损的两个越线组合。",
      "source_duration": 8.945458333333333,
      "start": 178.679292,
      "end": 186.094708,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 35,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "这说明一个字段的等级会同时影响多个保护对象，必须整体权衡。",
      "source_duration": 5.745458333333334,
      "start": 186.184708,
      "end": 190.967042,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 36,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "所以第二步，我们把整套等级方案当作一个决策，用强化学习求解。",
      "source_duration": 5.381833333333334,
      "start": 191.057042,
      "end": 195.508625,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 37,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "效用函数有三部分：M 大的字段留在低等级要扣安全分，调高等级要扣可用性分，仍成立的越线组合按超线幅度扣分。",
      "source_duration": 11.563625,
      "start": 195.598625,
      "end": 205.209333,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 38,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "每一步采样 128 套方案，按组内的相对好坏更新策略。",
      "source_duration": 5.6,
      "start": 205.299333,
      "end": 209.928667,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 39,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "比如日前节点边际电价调到 2 级后，整套方案的效用提高了 2.39，降回 1 级会有 4 个越线组合重新成立。",
      "source_duration": 9.890916666666667,
      "start": 210.018667,
      "end": 218.200625,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 40,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "15 个越线组合全部拆开，结果和整数规划求得的精确最优完全一致。",
      "source_duration": 6.909083333333333,
      "start": 218.290625,
      "end": 224.034208,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 41,
      "section": "07 二次定级：强化学习整体权衡",
      "text": "最后一步是整体核对，让每类接收方用它能拿到的全部字段重新训练，检查更大的组合。",
      "source_duration": 7.563625,
      "start": 224.124208,
      "end": 230.384167,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 42,
      "section": "08 定级效果",
      "text": "最后看效果。",
      "source_duration": 1.3818333333333332,
      "start": 230.884167,
      "end": 232.040458,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 43,
      "section": "08 定级效果",
      "text": "社会公众用它能拿到的全部字段推断实际网损，精度从 0.87 降到 0.65，降到了判定线以下。",
      "source_duration": 8.581833333333334,
      "start": 232.130458,
      "end": 239.238542,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 44,
      "section": "08 定级效果",
      "text": "我们还换用梯度提升树复测一遍，两种模型取较高的结果，避免低估风险。",
      "source_duration": 6.109083333333333,
      "start": 239.328542,
      "end": 244.40025,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 45,
      "section": "08 定级效果",
      "text": "发电总出力和大量字段高度相关，仍有一些超出判定线，系统把剩余风险如实列出来。",
      "source_duration": 7.636375,
      "start": 244.49025,
      "end": 250.835333,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 46,
      "section": "09 参数与其他任务",
      "text": "判定线、直接定级线、背景字段数和效用系数都可以修改，改完在线重算。",
      "source_duration": 7.272708333333333,
      "start": 251.335333,
      "end": 257.335875,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 47,
      "section": "09 参数与其他任务",
      "text": "我们在电网实测、电力仿真、社区统计、医疗保险、企业用能和楼宇传感器六个数据集上做了测试。",
      "source_duration": 9.018166666666668,
      "start": 257.425875,
      "end": 264.908958,
      "gap_after": 0.09,
      "caption_parts": 2
    },
    {
      "id": 48,
      "section": "09 参数与其他任务",
      "text": "最小越线组合从 2014 个降到 11 个。",
      "source_duration": 5.381833333333334,
      "start": 264.998958,
      "end": 269.457625,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 49,
      "section": "09 参数与其他任务",
      "text": "强化学习的结果在五个任务上与精确最优相同，另一个只差 0.4%。",
      "source_duration": 7.927291666666667,
      "start": 269.547625,
      "end": 276.137,
      "gap_after": 0.5,
      "caption_parts": 1
    },
    {
      "id": 50,
      "section": "10 结尾",
      "text": "总结一下，这个系统在逐字段定级之外，多做了三件事。",
      "source_duration": 5.381833333333334,
      "start": 276.637,
      "end": 281.091208,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 51,
      "section": "10 结尾",
      "text": "用模型实测各类接收方的聚合推断能力。",
      "source_duration": 4.145458333333333,
      "start": 281.181208,
      "end": 284.63125,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 52,
      "section": "10 结尾",
      "text": "用字段推断敏感度，把组合上的风险落到每个字段。",
      "source_duration": 5.018166666666667,
      "start": 284.72125,
      "end": 288.8635,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 53,
      "section": "10 结尾",
      "text": "用强化学习，把风险计入整套等级方案。",
      "source_duration": 3.4181666666666666,
      "start": 288.9535,
      "end": 291.80875,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 54,
      "section": "10 结尾",
      "text": "每次调级都给出可以核对的依据。",
      "source_duration": 2.9818333333333333,
      "start": 291.89875,
      "end": 294.386625,
      "gap_after": 0.09,
      "caption_parts": 1
    },
    {
      "id": 55,
      "section": "10 结尾",
      "text": "谢谢观看。",
      "source_duration": 0.8727083333333333,
      "start": 294.476625,
      "end": 295.211958,
      "gap_after": 0.5,
      "caption_parts": 1
    }
  ],
  "captions": [
    {
      "utterance": 1,
      "section": "01 开场",
      "text": "数据分级时，我们通常逐个字段判断等级，再按等级决定谁能拿到。",
      "start": 0.8,
      "end": 5.320333333333333
    },
    {
      "utterance": 2,
      "section": "01 开场",
      "text": "但接收方拿到的，是一批字段。",
      "start": 5.410333333333333,
      "end": 7.71125
    },
    {
      "utterance": 3,
      "section": "01 开场",
      "text": "这是美国 PJM 电网的公开数据，实际网损是电网企业的内部数据，",
      "start": 7.80125,
      "end": 13.401656318645117
    },
    {
      "utterance": 3,
      "section": "01 开场",
      "text": "社会公众无权获取。",
      "start": 13.416656318645117,
      "end": 14.677499999999998
    },
    {
      "utterance": 4,
      "section": "01 开场",
      "text": "负荷预测、节点电价、网损电价三个字段已经公开，单独推断网损都不到 0.5，",
      "start": 14.767499999999998,
      "end": 21.18321333496943
    },
    {
      "utterance": 4,
      "section": "01 开场",
      "text": "两两组合也不到 0.61。",
      "start": 21.19821333496943,
      "end": 22.609499999999997
    },
    {
      "utterance": 5,
      "section": "01 开场",
      "text": "三项合起来，推断精度达到 0.736，越过了判定线。",
      "start": 22.699499999999997,
      "end": 27.50020833333333
    },
    {
      "utterance": 6,
      "section": "01 开场",
      "text": "每个字段的等级都没有定错，组合起来却把不该公开的数据推了出来。",
      "start": 27.59020833333333,
      "end": 31.557624999999994
    },
    {
      "utterance": 7,
      "section": "01 开场",
      "text": "我们的系统，就是在定级时把这种聚合推断风险找出来，并计入等级。",
      "start": 31.647624999999998,
      "end": 36.589416666666665
    },
    {
      "utterance": 8,
      "section": "02 新建任务：上传一张表",
      "text": "新建任务只需要上传一张表格，CSV 或 Excel 都可以。",
      "start": 37.089416666666665,
      "end": 41.29666666666667
    },
    {
      "utterance": 9,
      "section": "02 新建任务：上传一张表",
      "text": "系统先识别每一列是数值、类别还是时间。",
      "start": 41.38666666666666,
      "end": 44.748916666666666
    },
    {
      "utterance": 10,
      "section": "02 新建任务：上传一张表",
      "text": "再由大模型根据列名和示例值，起草中文名、说明和公开情况。",
      "start": 44.83891666666666,
      "end": 49.7035
    },
    {
      "utterance": 11,
      "section": "02 新建任务：上传一张表",
      "text": "哪些是需要保护的数据，由我们自己确认，这里选实际网损、发电总出力等四项。",
      "start": 49.793499999999995,
      "end": 55.34320833333333
    },
    {
      "utterance": 12,
      "section": "02 新建任务：上传一张表",
      "text": "复核方式和计算设备也在这里选，没有显卡时自动用处理器。",
      "start": 55.433208333333326,
      "end": 59.952124999999995
    },
    {
      "utterance": 13,
      "section": "03 定级进度",
      "text": "确认后，后台依次完成一次定级、复核、推断验证、二次定级、整体核对与复测。",
      "start": 60.452124999999995,
      "end": 66.50083333333333
    },
    {
      "utterance": 14,
      "section": "03 定级进度",
      "text": "进度和日志实时显示，这份数据用一张显卡约 9 分钟完成。",
      "start": 66.59083333333332,
      "end": 71.19241666666666
    },
    {
      "utterance": 15,
      "section": "04 一次定级",
      "text": "第一步是一次定级，依据国家标准 GB/T 43697。",
      "start": 71.69241666666666,
      "end": 77.35679166666665
    },
    {
      "utterance": 16,
      "section": "04 一次定级",
      "text": "大模型只判断两件事：数据泄露后影响的对象，和影响的程度。",
      "start": 77.44679166666666,
      "end": 82.73941666666666
    },
    {
      "utterance": 17,
      "section": "04 一次定级",
      "text": "等级由国标的判定表查出来，不让大模型直接给等级。",
      "start": 82.82941666666666,
      "end": 87.24387499999999
    },
    {
      "utterance": 18,
      "section": "04 一次定级",
      "text": "判断要经过复核，比如实际网损反映的是企业自身的运行经济性，复核改为组织权益，",
      "start": 87.33387499999999,
      "end": 94.26268378923463
    },
    {
      "utterance": 18,
      "section": "04 一次定级",
      "text": "定为 2 级。",
      "start": 94.27768378923463,
      "end": 95.110125
    },
    {
      "utterance": 19,
      "section": "04 一次定级",
      "text": "也可以请另一个大模型来复核，它的意见单独列出，由人工决定是否采纳。",
      "start": 95.20012499999999,
      "end": 100.04279166666666
    },
    {
      "utterance": 20,
      "section": "05 单字段推断风险",
      "text": "第二步是推断验证。",
      "start": 100.54279166666666,
      "end": 102.37254166666666
    },
    {
      "utterance": 21,
      "section": "05 单字段推断风险",
      "text": "系统用接收方能拿到的字段，训练模型去推断保护对象，",
      "start": 102.46254166666665,
      "end": 106.85576224016354
    },
    {
      "utterance": 21,
      "section": "05 单字段推断风险",
      "text": "用留出数据上的拟合优度作为推断精度。",
      "start": 106.87076224016354,
      "end": 109.89824999999999
    },
    {
      "utterance": 22,
      "section": "05 单字段推断风险",
      "text": "对实际网损，最强的单个字段是负荷预测，也只有 0.49，没有一个字段单独过线。",
      "start": 109.98824999999998,
      "end": 115.76958333333332
    },
    {
      "utterance": 23,
      "section": "06 聚合推断：从集合到字段",
      "text": "推断风险的本质，是一组字段合起来能推到多准，它定义在字段集合上。",
      "start": 116.26958333333332,
      "end": 121.89195833333332
    },
    {
      "utterance": 24,
      "section": "06 聚合推断：从集合到字段",
      "text": "但等级要定在每个字段上，所以我们提出了字段推断敏感度 M。",
      "start": 121.98195833333331,
      "end": 126.66345833333331
    },
    {
      "utterance": 25,
      "section": "06 聚合推断：从集合到字段",
      "text": "M 衡量的是：接收方已经掌握了几个背景字段时，再拿到这个字段，",
      "start": 126.75345833333331,
      "end": 132.14256563400028
    },
    {
      "utterance": 25,
      "section": "06 聚合推断：从集合到字段",
      "text": "推断精度最多能提高多少。",
      "start": 132.1575656340003,
      "end": 134.33187499999997
    },
    {
      "utterance": 26,
      "section": "06 聚合推断：从集合到字段",
      "text": "比如日前节点边际电价，单独只有 0.27；有了两个背景字段，",
      "start": 134.42187499999997,
      "end": 139.08617270265154
    },
    {
      "utterance": 26,
      "section": "06 聚合推断：从集合到字段",
      "text": "它带来的提高达到 0.47。",
      "start": 139.10117270265152,
      "end": 141.01766666666663
    },
    {
      "utterance": 27,
      "section": "06 聚合推断：从集合到字段",
      "text": "多出来的这一部分，就是背景增益，图中的紫色斜纹，",
      "start": 141.10766666666663,
      "end": 144.62497186111855
    },
    {
      "utterance": 27,
      "section": "06 聚合推断：从集合到字段",
      "text": "它正是聚合推断在单个字段上的体现。",
      "start": 144.63997186111857,
      "end": 147.32216666666662
    },
    {
      "utterance": 28,
      "section": "06 聚合推断：从集合到字段",
      "text": "同时，系统找出所有最小越线组合：凑齐就越线，去掉任何一个就不越线。",
      "start": 147.41216666666662,
      "end": 152.9702916666666
    },
    {
      "utterance": 29,
      "section": "06 聚合推断：从集合到字段",
      "text": "开头那三个字段，就是一个最小越线组合。",
      "start": 153.06029166666661,
      "end": 155.5832083333333
    },
    {
      "utterance": 30,
      "section": "06 聚合推断：从集合到字段",
      "text": "我们证明了 M 和越线组合的对应关系：成员 M 都很小的组合不可能越线，",
      "start": 155.6732083333333,
      "end": 161.30391883333874
    },
    {
      "utterance": 30,
      "section": "06 聚合推断：从集合到字段",
      "text": "能把组合推过线的字段，一定属于某个最小越线组合。",
