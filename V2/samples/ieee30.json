要素、多个影响对象或影响程度，应按照就高从严原则确定数据级别。"}, {"编号": "6.6 f)", "标题": "衍生数据定级", "内容": "衍生数据级别可按照就高从严原则，在原始数据级别的基础上，综合考虑加工后的数据深度等分级要素对国家安全、经济运行、社会秩序、公共利益、组织权益、个人权益的影响进行确定。"}, {"编号": "附录H.1 a)", "标题": "1级数据", "内容": "数据一旦遭到泄露、篡改、损毁或者非法获取、非法使用、非法共享，不会对个人权益、组织权益等造成危害。1级数据具有公共传播属性，可对外公开发布、转发传播，但也需考虑公开的数据量及类别，避免由于类别较多或者数量过大被用于关联分析。"}, {"编号": "附录H.1 b)", "标题": "2级数据", "内容": "对个人权益、组织权益造成一般危害。2级数据通常在组织内部、关联方共享和使用，相关方授权后可向组织外部共享。"}, {"编号": "附录H.1 c)", "标题": "3级数据", "内容": "对个人权益、组织权益造成严重危害。3级数据仅可由授权的内部机构或人员访问，如果要将数据共享到外部，需要满足相关条件并获得相关方的授权。"}, {"编号": "附录H.1 d)", "标题": "4级数据", "内容": "对个人权益、组织权益造成特别严重危害，或对经济运行、社会秩序、公共利益造成一般危害。4级数据按照批准的授权列表严格管理，仅能在受控范围内经过严格审批、评估后才可共享或传播。"}, {"编号": "附录H.4", "标题": "最低参考级别", "内容": "敏感个人信息不低于4级，一般个人信息不低于2级；组织内部员工个人信息不低于2级；去标识化的个人信息不低于2级；个人标签信息不低于2级；有条件开放/共享的公共数据级别不低于2级，禁止开放/共享的公共数据不低于4级。"}, {"编号": "附录I", "标题": "衍生数据分级参考", "内容": "脱敏数据级别可比原始数据级别降低；统计数据级别可比原始数据级别降低或升高；融合数据级别要考虑数据汇聚融合结果，如果结果数据是对大量多维数据进行关联、分析或挖掘，汇聚了更大规模的原始数据或分析挖掘出更敏感、更深层的数据，级别可以升高。"}, {"编号": "附录G", "标题": "重要数据识别", "内容": "反映关键信息基础设施网络安全保护情况、可被利用实施对关键信息基础设施的网络攻击；反映重点目标、重要场所物理安全保护情况或未公开地理目标的位置；可被利用实施对关键设备、系统组件供应链的破坏；反映国家能源、关键矿产资源等战略储备和应急动员能力；直接影响电力等关键行业领域核心业务运行或重要经济领域生产的数据，宜识别为重要数据。"}], "接收方": [{"级": 1, "名称": "社会公众", "判定线": 0.7}, {"级": 2, "名称": "关联方", "判定线": 0.8}, {"级": 3, "名称": "特定授权对象", "判定线": 0.8}, {"级": 4, "名称": "内部受控范围", "判定线": 0.8}], "组合上限": 8, "已核对的组合数": 255, "字段": [{"字段": "sysload", "中文名": "系统总负荷", "类别": "行业数据", "公开情况": "已公开", "说明": "全系统各时段用电负荷之和，由市场运营机构对外发布", "影响对象": "经济运行", "影响程度": "无危害", "一次等级": 1, "初判": {"影响对象": "经济运行", "影响程度": "无危害", "等级": 1, "理由": "已对外公开发布，影响程度为无危害；非个人信息。"}, "复核调整": false, "检索到的条文": ["6.5 表1", "附录H.1 a)", "附录G", "附录H.1 c)"], "复核理由": "", "角色": "候选", "直接定级": 1, "二次等级": 1, "M": [0.334, 0.21, 0.093], "见证": [[], ["线路阻塞信息"], ["节点电价", "新能源出力预测"]], "单独精度": [0.334, 0.145, 0.0]}, {"字段": "lmp", "中文名": "节点电价", "类别": "行业数据", "公开情况": "已公开", "说明": "现货市场各节点的出清电价，由市场运营机构对外发布", "影响对象": "经济运行", "影响程度": "无危害", "一次等级": 1, "初判": {"影响对象": "经济运行", "影响程度": "无危害", "等级": 1, "理由": "节点电价由市场运营机构对外公开发布，已