{"id": "insurance", "名称": "医疗保险个人数据", "类别": "个人信息", "横轴": "个人（按真实费用排序）", "数据说明": "1338 名被保险人的个人属性与年度医疗费用。教学用的公开模拟数据，规模小，用作一眼能看懂的例子。", "接收方能力": [{"接收方": "社会公众", "敏感数据": "医疗费用", "判定线": 0.7, "可见字段数": [0, 0], "定级前": 0.0, "定级后": 0.0}, {"接收方": "关联方", "敏感数据": "医疗费用", "判定线": 0.8, "可见字段数": [6, 5], "定级前": 0.895, "定级后": 0.095}, {"接收方": "特定授权对象", "敏感数据": "医疗费用", "判定线": 0.8, "可见字段数": [6, 5], "定级前": 0.895, "定级后": 0.095}], "样本数": 1338, "规则库": "GB/T 43697 数据安全技术 数据分类分级规则", "大语言模型": "deepseek-flash", "等级表": [{"级": 1, "名称": "一般数据1级", "共享范围": "可对外公开发布", "接收方": "社会公众"}, {"级": 2, "名称": "一般数据2级", "共享范围": "组织内部、关联方共享和使用，授权后可向外部共享", "接收方": "关联方"}, {"级": 3, "名称": "一般数据3级", "共享范围": "仅授权的内部机构或人员访问，对外共享需满足条件并获得授权", "接收方": "特定授权对象"}, {"级": 4, "名称": "一般数据4级", "共享范围": "按批准的授权列表严格管理，受控范围内审批后共享", "接收方": "内部受控范围"}, {"级": 5, "名称": "重要数据", "共享范围": "不对外", "接收方": "无"}, {"级": 6, "名称": "核心数据", "共享范围": "不对外", "接收方": "无"}], "判定表": {"说明": "第6章表1给出核心、重要、一般三档；一般数据按附录H.1细分为1至4级", "国家安全": {"一般危害": 5, "严重危害": 6, "特别严重危害": 6}, "经济运行": {"一般危害": 4, "严重危害": 5, "特别严重危害": 6}, "社会秩序": {"一般危害": 4, "严重危害": 5, "特别严重危害": 6}, "公共利益": {"一般危害": 4, "严重危害": 5, "特别严重危害": 6}, "组织权益": {"一般危害": 2, "严重危害": 3, "特别严重危害": 4}, "个人权益": {"一般危害": 2, "严重危害": 3, "特别严重危害": 4}, "无危害": 1}, "条文": [{"编号": "4 c)", "标题": "就高从严原则", "内容": "采用就高不就低的原则确定数据级别，当多个因素可能影响数据分级时，按照可能造成的各个影响对象的最高影响程度确定数据级别。"}, {"编号": "4 d)", "标题": "点面结合原则", "内容": "数据分级既要考虑单项数据分级，也要充分考虑多个领域、群体或区域的数据汇聚融合后的安全影响，综合确定数据级别。"}, {"编号": "6.5 表1", "标题": "数据级别确定规则表", "内容": "影响国家安全：特别严重危害、严重危害为核心数据，一般危害为重要数据。影响经济运行、社会秩序、公共利益：特别严重危害为核心数据，严重危害为重要数据，一般危害为一般数据。仅影响组织权益、个人权益：一般数据。如果影响大规模的个人或组织权益，影响对象可能不只包括个人权益或组织权益。"}, {"编号": "6.6 c)", "标题": "多要素就高", "内容": "如待分级数据涉及多个要素、多个影响对象或影响程度，应按照就高从严原则确定数据级别。"}, {"编号": "6.6 f)", "标题": "衍生数据定级", "内容": "衍生数据级别可按照就高从严原则，在原始数据级别的基础上，综合考虑加工后的数据深度等分级要素对国家安全、经济运行、社会秩序、公共利益、组织权益、个人权益的影响进行确定。"}, {"编号": "附录H.1 a)", "标题": "1级数据", "内容": "数据一旦遭到泄露、篡改、损毁或者非法获取、非法使用、非法共享，不会对个人权益、组织权益等造成危害。1级数据具有公共传播属性，可对外公开发布、转发传播，但也需考虑公开的数据量及类别，避免由于类别较多或者数量过大被用于关联分析。"}, {"编号": "附录H.1 b)", "标题": "2级数据", "内容": "对个人权益、组织权益造成一般危害。2级数据通常在组织内部、关联方共享和使用，相关方授权后可向组织外部共享。"}, {"编号": "附录H.1 c)", "标题": "3级数据", "内容": "对个人权益、组织权益造成严重危害。3级数据仅可由授权的内部机构或人员访问，如果要将数据共享到外部，需要满足相关条件并获得相关方的授权。"}, {"编号": "附录H.1 d)", "标题": "4级数据", "内容": "对个人权益、组织权益造成特别严重危害，或对经济运行、社会秩序、公共利益造成一般危害。4级数据按照批准的授权列表严格管理，仅能在受控范围内经过严格审批、评估后才可共享或传播。"}, {"编号": "附录H.4", "标题": "最低参考级别", "内容": "敏感个人信息不低于4级，一般个人信息不低于2级；组织内部员工个人信息不低于2级；去标识化的个人信息不低于2级；个人标签信息不低于2级；有条件开放/共享的公共数据级别不低于2级，禁止开放/共享的公共数据不低于4级。"}, {"编号": "附录I", "标题": "衍生数据分级参考", "内容": "脱敏数据级别可比原始数据级别降低；统计数据级别可比原始数据级别降低或升高；融合数据级别要考虑数据汇聚融合结果，如果结果数据是对大量多维数据进行关联、分析或挖掘，汇聚了更大规模的原始数据或分析挖掘出更敏感、更深层的数据，级别可以升高。"}, {"编号": "附录G", "标题": "重要数据识别", "内容": "反映关键信息基础设施网络安全保护情况、可被利用实施对关键信息基础设施的网络攻击；反映重点目标、重要场所物理安全保护情况或未公开地理目标的位置；可被利用实施对关键设备、系统组件供应链的破坏；反映国家能源、关键矿产资源等战略储备和应急动员能力；直接影响电力等关键行业领域核心业务运行或重要经济领域生产的数据，宜识别为重要数据。"}], "接收方": [{"级": 1, "名称": "社会公众", "判定线": 0.7, "硬条件": true}, {"级": 2, "名称": "关联方", "判定线": 0.8, "硬条件": false}, {"级": 3, "名称": "特定授权对象", "判定线": 0.8, "硬条件": false}, {"级": 4, "名称": "内部受控范围", "判定线": 0.8, "硬条件": false}], "字段": [{"字段": "age", "中文名": "年龄", "类别": "个人信息", "公开情况": "未公开", "说明": "被保险人的年龄", "影响对象": "个人权益", "影响程度": "一般危害", "一次等级": 2, "初判": {"影响对象": "个人权益", "影响程度": "一般危害", "等级": 2, "理由": "年龄为一般个人信息，未公开，泄露仅影响个人权益，造成一般危害，级别不低于2级。"}, "复核调整": false, "检索到的条文": ["6.5 表1", "附录H.4", "附录H.1 b)", "附录H.1 c)"], "复核理由": "", "角色": "候选", "直接定级": 2, "二次等级": 2, "M": [0.105], "见证": [["是否吸烟"]], "单独精度": [0.087]}, {"字段": "sex", "中文名": "性别", "类别": "个人信息", "公开情况": "未公开", "说明": "被保险人的性别", "影响对象": "个人权益", "影响程度": "一般危害", "一次等级": 2, "初判": {"影响对象": "个人权益", "影响程度": "一般危害", "等级": 2, "理由": "性别为一般个人信息，未公开，泄露仅对个人权益造成一般危害，级别不低于2级。"}, "复核调整": false, "检索到的条文": ["6.5 表1", "附录H.4", "附录H.1 b)", "附录H.1 c)"], "复核理由": "", "角色": "候选", "直接定级": 2, "二次等级": 2, "M": [0.009], "见证": [["体重指数", "子女数"]], "单独精度": [0.003]}, {"字段": "bmi", "中文名": "体重指数", "类别": "个人信息", "公开情况": "未公开", "说明": "被保险人的体重指数，由身高体重计算", "影响对象": "个人权益", "影响程度": "一般危害", "一次等级": 2, "初判": {"影响对象": "个人权益", "影响程度": "一般危害", "等级": 2, "理由": "